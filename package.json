{
  "name": "priceguard-ai",
  "version": "0.9.96",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:e2e": "vitest run src/e2e",
    "test:watch": "vitest",
    "package:zip": "node scripts/bump-version.mjs && npm run build && node scripts/package.mjs",
    "analyze": "vite build --mode analyze",
    "qa:preflight": "node scripts/qa-preflight.mjs",
    "smoke:scrappey": "node scripts/smoke-scrappey.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:edge-imports": "node scripts/check-edge-imports.mjs",
    "check:edge": "node scripts/deno-check-functions.mjs"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@supabase/supabase-js": "^2.110.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.11",
    "vitest": "^3.2.6"
  }
