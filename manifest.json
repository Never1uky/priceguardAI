{
  "manifest_version": 3,
  "name": "PriceGuard AI",
  "version": "0.9.140",
  "description": "AI-анализ отзывов, сравнение цен на маркетплейсах и алерты в Telegram — даже без открытого Chrome",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://www.wildberries.ru/*",
    "https://wildberries.ru/*",
    "https://card.wb.ru/*",
    "https://search.wb.ru/*",
    "https://feedbacks1.wb.ru/*",
    "https://feedbacks2.wb.ru/*",
    "https://*.wbbasket.ru/*",
    "https://www.ozon.ru/*",
    "https://ozon.ru/*",
    "https://market.yandex.ru/*",
    "https://megamarket.ru/*",
    "https://www.megamarket.ru/*",
    "https://sbermegamarket.ru/*",
    "https://www.sbermegamarket.ru/*",
    "https://aliexpress.ru/*",
    "https://*.aliexpress.ru/*",
    "https://www.mvideo.ru/*",
    "https://mvideo.ru/*",
    "https://www.dns-shop.ru/*",
    "https://dns-shop.ru/*",
    "https://www.citilink.ru/*",
    "https://citilink.ru/*",
    "https://www.eldorado.ru/*",
    "https://eldorado.ru/*",
    "https://www.lamoda.ru/*",
    "https://lamoda.ru/*",
    "https://ihlfvpocwobvcpxbypsd.supabase.co/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://priceguard-seo.vercel.app/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ]
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "PriceGuard AI",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "32": "public/icons/icon32.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.wildberries.ru/catalog/*",
        "https://wildberries.ru/catalog/*",
        "https://www.wildberries.ru/catalog/0/search.aspx*",
        "https://www.ozon.ru/product/*",
        "https://ozon.ru/product/*",
        "https://www.ozon.ru/context/detail/id/*",
        "https://ozon.ru/context/detail/id/*",
        "https://www.ozon.ru/search*",
        "https://ozon.ru/search*",
        "https://market.yandex.ru/search*",
        "https://market.yandex.ru/product*",
        "https://market.yandex.ru/card*",
        "https://market.yandex.ru/cc/*",
        "https://megamarket.ru/catalog/*",
        "https://www.megamarket.ru/catalog/*",
        "https://sbermegamarket.ru/catalog/*",
        "https://www.sbermegamarket.ru/catalog/*",
        "https://aliexpress.ru/item/*",
        "https://*.aliexpress.ru/item/*",
        "https://aliexpress.ru/wholesale*",
        "https://*.aliexpress.ru/wholesale*",
        "https://www.mvideo.ru/products/*",
        "https://mvideo.ru/products/*",
        "https://www.mvideo.ru/product-list-page*",
        "https://mvideo.ru/product-list-page*",
        "https://www.dns-shop.ru/product/*",
        "https://dns-shop.ru/product/*",
        "https://www.dns-shop.ru/search*",
        "https://dns-shop.ru/search*",
        "https://www.citilink.ru/product/*",
        "https://citilink.ru/product/*",
        "https://www.citilink.ru/search*",
        "https://citilink.ru/search*",
        "https://www.eldorado.ru/cat/detail/*",
        "https://eldorado.ru/cat/detail/*",
        "https://www.eldorado.ru/item/*",
        "https://eldorado.ru/item/*",
        "https://www.eldorado.ru/search*",
        "https://eldorado.ru/search*",
        "https://www.eldorado.ru/catalog/product/*",
        "https://eldorado.ru/catalog/product/*",
        "https://www.lamoda.ru/p/*",
        "https://lamoda.ru/p/*",
        "https://www.lamoda.ru/catalogsearch/*",
        "https://lamoda.ru/catalogsearch/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    }
  ]
}
