# PriceGuard AI — переменные окружения
# Скопируйте в .env и заполните после создания проекта Supabase
#
# ВАЖНО: это Chrome-расширение (Vite), не Next.js.
# Используйте префикс VITE_, а не NEXT_PUBLIC_.
# Пакеты @supabase/ssr и middleware из Next.js-гайда здесь не нужны.

# Supabase (Dashboard → Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# anon key (JWT) или новый publishable key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# альтернативное имя (если скопировали из Next.js-гайда):
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL возврата после оплаты ЮKassa (страница «спасибо»)
VITE_PAYMENT_RETURN_URL=https://priceguard-landing.vercel.app/payment/success
# Публичные реквизиты продавца
VITE_REQUISITES_URL=https://priceguard-landing.vercel.app/requisites

# Секреты только для Supabase Edge Functions (НЕ в расширение!):
# AITUNNEL_API_KEY=sk-aitunnel-...   ← рекомендуется (gpt-4o-mini + grok-3-mini)
# GROK_API_KEY=...
# OPENAI_API_KEY=...
# YOOKASSA_SHOP_ID=...
# YOOKASSA_SECRET_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
#
# Auth / email (Dashboard → Authentication):
# Confirm email выключен (config.toml enable_confirmations=false) —
# встроенная почта Supabase плохо доходит до Яндекс/Mail.ru.
# Для сброса пароля и писем: подключите Custom SMTP (Resend / Unisender / свой SMTP).
